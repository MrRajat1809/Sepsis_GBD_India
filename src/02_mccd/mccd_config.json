{
  "version": "1.0.0",
  "raw_directory": "data/raw/mccd",
  "years": [
    2008,
    2023
  ],
  "pdftotext": {
    "command": "pdftotext",
    "arguments": [
      "-table",
      "-enc",
      "UTF-8"
    ],
    "reference_version": "4.00"
  },
  "all_india": "India (all reporting States/UTs)",
  "india_mccd_reporting": "India (MCCD reporting States/UTs)",
  "merged_dnh": "Dadra & Nagar Haveli and Daman & Diu",
  "merged_dnh_from_year": 2020,
  "state_patterns": [
    {
      "name": "India (all reporting States/UTs)",
      "pattern": "\\bAll(\\s+States)?\\b"
    },
    {
      "name": "India (MCCD reporting States/UTs)",
      "pattern": "Total\\s+MCCD\\s+Reporting"
    },
    {
      "name": "India (all registered deaths)",
      "pattern": "\\bTotal\\b"
    },
    {
      "name": "Dadra & Nagar Haveli and Daman & Diu",
      "pattern": "D\\s*&\\s*N\\s+Haveli\\s*&\\s+Daman\\s*&\\s*Diu"
    },
    {
      "name": "Dadra & Nagar Haveli",
      "pattern": "D\\s*&\\s*N\\s+Haveli|Dadra\\s*(&|and)?\\s*Nagar\\s+Haveli"
    },
    {
      "name": "Daman & Diu",
      "pattern": "Daman\\*?\\s*&\\s*Diu"
    },
    {
      "name": "Andhra Pradesh",
      "pattern": "Andhra\\s+Pradesh"
    },
